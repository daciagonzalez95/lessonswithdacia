# Set these in the hosting environment. Do not commit real values.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=bookings.sqlite3
# Use Supabase's Transaction pooler URI (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
BUSINESS_TIMEZONE=America/Los_Angeles
PUBLIC_BASE_URL=https://your-booking-domain.example
ADMIN_PASSWORD=replace-with-a-long-unique-password
MANAGE_LINK_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_live_or_test_value
STRIPE_WEBHOOK_SECRET=whsec_value
CONTACT_EMAIL=coach@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Coach Dacia <coach@example.com>
